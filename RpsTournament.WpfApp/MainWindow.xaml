<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi-paber-käärid"
        Height="520"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Player name -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Mängija nimi:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,10"/>

        <TextBox x:Name="PlayerNameTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Height="30"
                 Margin="0,0,0,10"/>

        <!-- Player move -->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Vali käik:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,10"/>

        <ComboBox x:Name="PlayerMoveComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Height="30"
                  Margin="0,0,0,10"/>

        <!-- Play button -->
        <Button x:Name="PlayRoundButton"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="Mängi voor"
                Height="35"
                Width="140"
                HorizontalAlignment="Left"
                Margin="0,5,0,15"
                Click="PlayRoundButton_Click"/>

        <!-- Rounds -->
        <DataGrid x:Name="RoundsDataGrid"
                  Grid.Row="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Voor"
                                    Binding="{Binding Number}"/>

                <DataGridTextColumn Header="Mängija"
                                    Binding="{Binding PlayerMove}"/>

                <DataGridTextColumn Header="Arvuti"
                                    Binding="{Binding ComputerMove}"/>

                <DataGridTextColumn Header="Tulemus"
                                    Binding="{Binding Result}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Score -->
        <TextBlock x:Name="ScoreTextBlock"
                   Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Võidud: 0 | Kaotused: 0 | Viigid: 0"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- New tournament -->
        <Button x:Name="NewTournamentButton"
                Grid.Row="4"
                Grid.Column="2"
                Content="Uus turniir"
                Width="120"
                Height="32"
                HorizontalAlignment="Right"
                Click="NewTournamentButton_Click"/>

        <!-- Status -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="5"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"/>

    </Grid>

</Window>